  "css": "[data-slot=\"button\"]{border-radius:999px!important;font-weight:500;}\n[data-slot=\"input\"],[data-slot=\"select-trigger\"]{border-radius:999px!important;}\n[data-thread-item]{border-radius:10px!important;}\n[data-slot=\"composer-host\"]{border-radius:24px!important;border:1px solid var(--border)!important;box-shadow:none!important;}\n.dark [data-slot=\"composer-host\"]:focus-within{border-color:#1C62B9!important;}\n:root:not(.dark) [data-slot=\"composer-host\"]:focus-within{border-color:#1C62B9!important;}\nbutton.bg-message-action{border-radius:999px!important;}\n[data-user-message-bubble]{border-radius:12px!important;}\n.chat-markdown-codeblock{border-radius:12px!important;border:none;}\n[data-slot=\"dialog-popup\"]{border-radius:12px!important;border:none!important;}\n[data-slot=\"popover-popup\"],[data-slot=\"menu-popup\"]{border-radius:12px!important;border:none!important;box-shadow:0 4px 32px rgba(0,0,0,.1)!important;}\n[data-slot=\"tooltip-popup\"]{border-radius:4px!important;background:#717171!important;color:#FFFFFF!important;}\nbutton.bg-message-action:disabled{background:color-mix(in srgb,var(--foreground) 10%,transparent)!important;color:var(--muted-foreground)!important;opacity:1!important;}\n.dark [data-slot=\"switch\"][data-unchecked]{background:#717171!important;box-shadow:none!important;}\n:root:not(.dark) [data-slot=\"switch\"][data-unchecked]{background:#CCCCCC!important;box-shadow:none!important;}\n[data-slot=\"switch\"][data-unchecked] [data-slot=\"switch-thumb\"]{background:#FFFFFF!important;}\n.dark [data-slot=\"switch\"][data-checked]{background:#3EA6FF!important;box-shadow:none!important;}\n:root:not(.dark) [data-slot=\"switch\"][data-checked]{background:#065FD4!important;box-shadow:none!important;}\n[data-slot=\"switch\"][data-checked] [data-slot=\"switch-thumb\"]{background:#FFFFFF!important;}\n::-webkit-scrollbar{width:8px;height:8px;}\n::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--foreground) 30%,transparent);border-radius:999px;}"
