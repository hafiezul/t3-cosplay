  "css": "[data-thread-item]{border-radius:4px!important;}\n[data-slot=\"button\"]{border-radius:4px!important;}\n[data-slot=\"input\"],[data-slot=\"select-trigger\"]{border-radius:4px!important;}\n[data-slot=\"composer-host\"]{border-radius:8px!important;border:none!important;box-shadow:none!important;background:var(--input)!important;}\n[data-user-message-bubble]{border-radius:8px!important;}\n.chat-markdown-codeblock{border-radius:4px!important;border:1px solid var(--border);}\n[data-slot=\"dialog-popup\"]{border-radius:8px!important;border:none!important;box-shadow:0 8px 16px rgba(0,0,0,.24)!important;}\n[data-slot=\"popover-popup\"],[data-slot=\"menu-popup\"]{border-radius:4px!important;border:none!important;box-shadow:0 8px 16px rgba(0,0,0,.24)!important;}\n.dark [data-slot=\"tooltip-popup\"]{border-radius:4px!important;background:#111214!important;color:#DBDEE1!important;}\n:root:not(.dark) [data-slot=\"tooltip-popup\"]{border-radius:4px!important;}\nbutton.bg-message-action:disabled{background:color-mix(in srgb,var(--foreground) 12%,transparent)!important;color:var(--muted-foreground)!important;opacity:1!important;}\n[data-slot=\"switch\"][data-unchecked]{background:#80848E!important;box-shadow:none!important;}\n[data-slot=\"switch\"][data-unchecked] [data-slot=\"switch-thumb\"]{background:#FFFFFF!important;}\n[data-slot=\"switch\"][data-checked]{background:#23A55A!important;box-shadow:none!important;}\n[data-slot=\"switch\"][data-checked] [data-slot=\"switch-thumb\"]{background:#FFFFFF!important;}\n::-webkit-scrollbar{width:8px;height:8px;}\n::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--foreground) 18%,transparent);border-radius:999px;border:2px solid transparent;background-clip:padding-box;}"
